# Copy to .env and fill in. All are optional — the model dropdown only lists
# providers whose key is actually present, and the scripted demo agent needs none.

# Agent model providers (at least one needed for the real LLM-driven agent)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
NVIDIA_API_KEY=

# forge.deploy — a Vercel access token scoped to THIS project only.
# Without it, forge.deploy degrades to exporting a file bundle.
VERCEL_ACCESS_TOKEN=

# forge.image.generate uses OPENROUTER_API_KEY above.
# forge.terminal.exec uses Vercel Sandbox, authenticated automatically via
# OIDC when deployed on Vercel — no key needed.
