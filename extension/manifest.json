{
  "manifest_version": 3,
  "name": "Inscribe Universal",
  "version": "0.1.0",
  "description": "Tinker with any website by describing what you want: restyle it, hide things, rewrite text, or have an agent operate it \u2014 with every change shown and reversible.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Toggle Inscribe"
  },
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Toggle the Inscribe overlay"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/page/bootstrap.js",
        "src/page/synthesize.js",
        "src/page/tinker.js",
        "src/page/registrar.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/isolated/relay.js",
        "src/isolated/overlay.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
